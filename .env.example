# GCP Project
GOOGLE_CLOUD_PROJECT=your-project-id

# GCS Bucket (same bucket used by pipeline and API)
GCS_BUCKET_NAME=mississauga-smart-city-data

# Pipeline — ArcGIS org ID discovered from Hub API response
ARCGIS_ORG_ID=

# API Server
PORT=8080
CACHE_REFRESH_MINUTES=60

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
